---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { getPostLocale } from "@/utils/postLocale";
import { useTranslations } from "@/i18n";

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const locale = getPostLocale(post);
const t = useTranslations(locale);
const posts = await getCollection("posts");
const translations = posts.filter(
  candidate =>
    candidate.data.translationKey === post.data.translationKey &&
    candidate.data.translationKey
);

const languageNames: Record<string, string> = {
  en: "English",
  de: "Deutsch",
};
---

{
  translations.length > 1 && (
    <nav
      class="my-4 flex items-center gap-2 text-sm"
      aria-label={t.a11y.languageSwitcher}
    >
      <span class="text-muted-foreground">{t.a11y.languageSwitcher}:</span>
      <ul class="flex gap-2">
        {translations.map(translation => (
          <li>
            <a
              href={getPostUrl(
                translation.id,
                translation.filePath,
                getPostLocale(translation)
              )}
              lang={getPostLocale(translation)}
              aria-current={
                getPostLocale(translation) === locale ? "page" : undefined
              }
              class:list={[
                "rounded border px-2 py-1 transition-colors",
                {
                  "border-accent text-accent":
                    getPostLocale(translation) === locale,
                  "border-border hover:border-accent hover:text-accent":
                    getPostLocale(translation) !== locale,
                },
              ]}
            >
              {languageNames[getPostLocale(translation)] ??
                getPostLocale(translation)}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
