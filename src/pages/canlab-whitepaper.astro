---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const isGerman = locale === "de";
const whitepaper = await getEntry(
  "pages",
  isGerman ? "canlab-whitepaperde" : "canlab-whitepaper"
);

if (!whitepaper) {
  throw new Error(
    "Missing content entry: `canlab-whitepaper.md` or `canlab-whitepaper.de.md` in `src/content/pages/`"
  );
}

const { Content } = await render(whitepaper);

const alternateLinks = [
  { locale: "en", url: new URL("/canlab-whitepaper", Astro.site).href },
  { locale: "de", url: new URL("/de/canlab-whitepaper", Astro.site).href },
];
---

<Layout
  title={`${whitepaper.data.title} | ${config.site.title}`}
  description={whitepaper.data.description}
  ogImage={whitepaper.data.ogImage}
  ogLocale={isGerman ? "de_DE" : "en_GB"}
  alternateLinks={alternateLinks}
  canonicalURL={whitepaper.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={whitepaper.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
