---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { codeStatsProfileUrl, getCodeStats } from "@/utils/codeStats";
import { credlyProfileUrl, getCredlyBadges } from "@/utils/credly";
import {
  getGitHubProfile,
  githubAchievementsUrl,
  githubProfileUrl,
} from "@/utils/githubProfile";
import { getMicrosoftLearnStats } from "@/utils/microsoftLearn";

const locale = Astro.currentLocale ?? config.site.lang;
const about = await getEntry("pages", locale === "de" ? "aboutde" : "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
const [stats, badges, codeStats, [githubContributions, githubAchievements]] =
  await Promise.all([
    getMicrosoftLearnStats(),
    getCredlyBadges(),
    getCodeStats(),
    getGitHubProfile(),
  ]);
const isGerman = locale === "de";
const formatLocale = isGerman ? "de-DE" : "en-GB";
const number = new Intl.NumberFormat(formatLocale);
const date = new Intl.DateTimeFormat(formatLocale, {
  dateStyle: "long",
  timeZone: "Europe/Berlin",
});
const credentialDate = new Intl.DateTimeFormat(formatLocale, {
  dateStyle: "medium",
  timeZone: "UTC",
});
const credentialCategories = new Map([
  ["Certification", isGerman ? "Zertifizierung" : "Certification"],
  ["Learning", isGerman ? "Lernnachweis" : "Learning badge"],
]);
const metrics = stats && [
  { label: "Level", value: stats.level },
  { label: "XP", value: stats.xp },
  { label: "Badges", value: stats.badges },
  { label: isGerman ? "Trophäen" : "Trophies", value: stats.trophies },
];
const profileUrl = `https://learn.microsoft.com/${isGerman ? "de-de" : "en-gb"}/users/alademann/`;
const contributionDays = githubContributions?.days ?? [];
const contributionWeeks =
  Math.max(0, ...contributionDays.map(day => day.week)) + 1;
const contributionColours = [
  "bg-muted",
  "bg-accent/25",
  "bg-accent/50",
  "bg-accent/75",
  "bg-accent",
];
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose">
    <Content />

    <section aria-labelledby="microsoft-learn">
      <h2 id="microsoft-learn">Microsoft Learn</h2>

      {
        stats && metrics && (
          <>
            <dl class="not-prose border-border my-4 grid grid-cols-2 gap-x-4 gap-y-4 border-y py-4 sm:grid-cols-4">
              {metrics.map(({ label, value }) => (
                <div>
                  <dt class="text-sm">{label}</dt>
                  <dd class="text-accent text-2xl font-semibold tabular-nums">
                    {number.format(value)}
                  </dd>
                </div>
              ))}
            </dl>
            <p class="text-sm">
              {isGerman ? "Abgerufen am " : "Last checked "}
              <time datetime={stats.fetchedAt}>
                {date.format(new Date(stats.fetchedAt))}
              </time>
            </p>
          </>
        )
      }

      <p>
        <a href={profileUrl}>
          {
            isGerman
              ? "Mein Microsoft-Learn-Profil"
              : "My Microsoft Learn profile"
          }
        </a>
      </p>
    </section>

    <section aria-labelledby="credly-credentials">
      <h2 id="credly-credentials">
        {
          isGerman
            ? "Zertifikate und Lernnachweise"
            : "Certifications and learning badges"
        }
      </h2>

      {
        badges.length > 0 && (
          <ul
            class="not-prose divide-border border-border my-4 list-none divide-y border-y p-0"
            role="list"
          >
            {badges.map(badge => (
              <li class="flex items-start gap-4 py-4">
                <div class="w-12 shrink-0 sm:w-16">
                  {badge.imageUrl && (
                    <img
                      src={badge.imageUrl}
                      alt=""
                      width="64"
                      height="64"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      class="m-0 aspect-square w-full border-0 object-contain"
                    />
                  )}
                </div>
                <div class="min-w-0">
                  <a
                    href={badge.verificationUrl}
                    class="font-semibold underline decoration-dashed underline-offset-4"
                  >
                    {badge.title}
                  </a>
                  <p class="my-1 text-sm">
                    {[
                      badge.issuer,
                      credentialCategories.get(badge.category ?? ""),
                    ]
                      .filter(Boolean)
                      .join(" · ")}
                  </p>
                  <p class="text-muted-foreground m-0 text-xs">
                    {isGerman ? "Ausgestellt am " : "Issued "}
                    <time datetime={badge.issuedOn}>
                      {credentialDate.format(new Date(badge.issuedOn))}
                    </time>
                    {badge.expiresOn && (
                      <>
                        {isGerman ? " · Ablaufdatum " : " · Expiry date "}
                        <time datetime={badge.expiresOn}>
                          {credentialDate.format(new Date(badge.expiresOn))}
                        </time>
                      </>
                    )}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        )
      }

      <p>
        <a href={credlyProfileUrl}>
          {isGerman ? "Mein Credly-Profil" : "My Credly profile"}
        </a>
      </p>
    </section>

    <section aria-labelledby="code-stats">
      <h2 id="code-stats">Code::Stats</h2>

      {
        codeStats && (
          <>
            <dl class="not-prose border-border my-4 grid grid-cols-2 gap-4 border-y py-4">
              <div>
                <dt class="text-sm">{isGerman ? "XP gesamt" : "Total XP"}</dt>
                <dd class="text-accent text-2xl font-semibold tabular-nums">
                  {number.format(codeStats.totalXp)}
                </dd>
              </div>
              <div>
                <dt class="text-sm">Level</dt>
                <dd class="text-accent text-2xl font-semibold tabular-nums">
                  {number.format(codeStats.level)}
                </dd>
              </div>
            </dl>
            {codeStats.topLanguages.length > 0 && (
              <>
                <h3>
                  {isGerman
                    ? "Sprachen und Formate nach XP"
                    : "Languages and formats by XP"}
                </h3>
                <ol class="not-prose my-4 list-none space-y-3 p-0" role="list">
                  {codeStats.topLanguages.map(language => (
                    <li class="text-sm">
                      <div class="flex items-baseline justify-between gap-4">
                        <span class="font-medium">{language.name}</span>
                        <span class="shrink-0 tabular-nums">
                          {number.format(language.xp)} XP
                        </span>
                      </div>
                      <div aria-hidden="true" class="bg-muted mt-1 h-1.5">
                        <div
                          class="bg-accent h-full"
                          style={{
                            width: `${(100 * language.xp) / codeStats.topLanguages[0].xp}%`,
                          }}
                        />
                      </div>
                    </li>
                  ))}
                </ol>
              </>
            )}
            <p class="text-sm">
              {isGerman ? "Abgerufen am " : "Last checked "}
              <time datetime={codeStats.fetchedAt}>
                {date.format(new Date(codeStats.fetchedAt))}
              </time>
            </p>
          </>
        )
      }

      <p>
        <a href={codeStatsProfileUrl}>
          {isGerman ? "Mein Code::Stats-Profil" : "My Code::Stats profile"}
        </a>
      </p>
    </section>

    <section aria-labelledby="github">
      <h2 id="github">GitHub</h2>
      {
        githubContributions && (
          <>
            <p class="not-prose mt-4 mb-3 text-sm">
              <strong class="text-accent mr-1 text-2xl font-semibold tabular-nums">
                {number.format(githubContributions.total)}
              </strong>
              {isGerman
                ? "Beiträge im letzten Jahr"
                : "contributions in the last year"}
            </p>
            {contributionDays.length > 0 && (
              <div
                aria-hidden="true"
                class="not-prose mb-4 grid grid-rows-7 gap-px sm:gap-[2px]"
                style={{
                  gridTemplateColumns: `repeat(${contributionWeeks}, minmax(0, 1fr))`,
                }}
              >
                {contributionDays.map(day => (
                  <span
                    class:list={[
                      "aspect-square rounded-[1px]",
                      contributionColours[day.level],
                    ]}
                    style={{
                      gridColumn: day.week + 1,
                      gridRow: day.weekday + 1,
                    }}
                    title={date.format(new Date(day.date))}
                  />
                ))}
              </div>
            )}
          </>
        )
      }

      {
        githubAchievements && githubAchievements.length > 0 && (
          <>
            <h3>Achievements</h3>
            <ul
              class="not-prose my-4 grid list-none grid-cols-2 gap-2 p-0 sm:grid-cols-4"
              role="list"
            >
              {githubAchievements.map(achievement => (
                <li class="min-w-0">
                  <a
                    href={achievement.url}
                    class="border-border flex h-full flex-col items-center gap-2 border px-2 py-3 text-center text-sm"
                  >
                    <img
                      src={achievement.imageUrl}
                      alt=""
                      width="48"
                      height="48"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                      class="m-0 border-0"
                    />
                    <span>
                      {achievement.title} {achievement.tier}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }

      <p>
        <a href={githubProfileUrl}
          >{isGerman ? "Mein GitHub-Profil" : "My GitHub profile"}</a
        >
        {" · "}
        <a href={githubAchievementsUrl}
          >{isGerman ? "Achievements auf GitHub" : "Achievements on GitHub"}</a
        >
      </p>
    </section>
  </Main>

  <Footer />
</Layout>
